# --- Environment ---
# local: development + COOKIE_SECURE=false. production (hosted): NODE_ENV=production + COOKIE_SECURE=true
NODE_ENV=development
PORT=5000

# --- Database (MySQL / TiDB Cloud, Prisma) ---
# Set DATABASE_URL to your MySQL-compatible connection string (never commit the real one).
#
# Local MySQL (e.g. XAMPP, default root/no password):
# DATABASE_URL="mysql://root:@localhost:3306/khyleenes_collection"
#
# TiDB Cloud (Serverless) — cluster Connect > General; uses port 4000 + TLS required.
# Create/reset password in TiDB, URL-encode special chars in the password.
# DATABASE_URL="mysql://<USER>.root:<PASSWORD>@<HOST>:4000/<DATABASE>?sslaccept=strict"
#
# Other managed MySQL: use the URI your provider gives (add its SSL param if required).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/khyleenes_collection"

# --- Auth / Security (backend only) ---
# JWT_SECRET must be long & random in production (32+ chars). Change SEED_ADMIN_PASSWORD.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# true in production/HTTPS (enables cross-site cookie auth); false for local http
COOKIE_SECURE=false
# Exact frontend origin (used for CORS). Prod: https://your-frontend-domain (no trailing slash)
FRONTEND_URL=http://localhost:5173

# --- Optional integrations (backend only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Khyleene's Collection <no-reply@khyleenescollection.com>"

# --- Seed / business (dev/ops) ---
SEED_ADMIN_EMAIL=admin@khyleenescollection.local
SEED_ADMIN_PASSWORD=ChangeMe123!
STOCK_RESERVATION_MINUTES=30

# Manual payment instructions (GCash / Bank transfer)
GCASH_NAME=
GCASH_NUMBER=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
